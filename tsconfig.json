{
  "compilerOptions": {
    "module": "commonjs",
    "rootDir": "./main/src",
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "main/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}